//@version=5
indicator("Scopes demo")

f() =>
    var x = 0

    if close > 0
        x += 0
    if close > 1
        x += 1
    // ... Repeat this `if close > n` pattern until `n = 299`.
    if close > 299
        x += 299

plot(f())
plot(request.security(syminfo.tickerid, "1D", f())) // No compilation error.