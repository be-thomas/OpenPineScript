{
  "name": "open-pinescript",
  "version": "0.0.1",
  "scripts": {
    "generate:parser": "node scripts/common/build-grammars.mjs && node scripts/common/patch-visitor.js",
    "generate:parser:v1": "node scripts/common/build-grammars.mjs v1",
    "generate:parser:v2": "node scripts/common/build-grammars.mjs v2",
    "generate:parser:v3": "node scripts/common/build-grammars.mjs v3",
    "generate:parser:v4": "node scripts/common/build-grammars.mjs v4",
    "generate:parser:v5": "node scripts/common/build-grammars.mjs v5",
    "postinstall": "npm run generate:parser",
    "prebuild": "ts-node scripts/common/generate-metadata.ts",
    "build": "npm run generate:parser",
    "parse": "tsx parser/v2/run_antlr.ts",
    "replv2": "tsx repl/v2/index.ts",
    "opsv2": "tsx mock_run/v2/run.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "antlr4ng": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "antlr-ng": "^1.0.0",
    "ts-morph": "^27.0.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
