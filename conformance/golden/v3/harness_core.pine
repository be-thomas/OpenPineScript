//@version=3
// ─────────────────────────────────────────────────────────────────────────────
// OpenPineScript golden-data harness 1 of 3 — CONVERGENT indicators.
//
// Paste into the TradingView Pine editor, add to the chart, then use
// "Export chart data…". See README.md in this directory for the full recipe.
//
// Everything here is CONVERGENT: its value depends on a bounded window, or
// converges exponentially, so it is safe to export a window that does not start
// at the instrument's first bar. The comparison skips a warm-up allowance.
//
// If TradingView rejects //@version=3, change ONLY line 1 to //@version=4 — the
// built-ins below are spelled identically in v4, and the test forces our engine
// to read the file as v3 regardless of the annotation.
//
// If TradingView rejects one specific plot, DELETE THAT LINE. The test compares
// the intersection of the CSV's columns and our engine's plots, so a missing
// column costs only that one assertion.
// ─────────────────────────────────────────────────────────────────────────────
study(title="OPS golden core", shorttitle="OPS core", overlay=false)

src = close

plot(sma(src, 20),                  title="sma_20")
plot(ema(src, 20),                  title="ema_20")
plot(rma(src, 20),                  title="rma_20")
plot(wma(src, 20),                  title="wma_20")
plot(vwma(src, 20),                 title="vwma_20")
plot(swma(src),                     title="swma")
plot(rsi(src, 14),                  title="rsi_14")
plot(atr(14),                       title="atr_14")
plot(tr(true),                      title="tr_true")
plot(stdev(src, 20),                title="stdev_20")
plot(variance(src, 20),             title="variance_20")
plot(dev(src, 20),                  title="dev_20")
plot(cci(src, 20),                  title="cci_20")
plot(mom(src, 10),                  title="mom_10")
plot(roc(src, 10),                  title="roc_10")
plot(change(src),                   title="change_1")
plot(highest(high, 20),             title="highest_20")
plot(lowest(low, 20),               title="lowest_20")
plot(highestbars(high, 20),         title="highestbars_20")
plot(lowestbars(low, 20),           title="lowestbars_20")
plot(linreg(src, 20, 0),            title="linreg_20_0")
plot(correlation(src, volume, 20),  title="correlation_20")
plot(stoch(close, high, low, 14),   title="stoch_14")
plot(cog(src, 20),                  title="cog_20")

// Williams %R and Money Flow Index, written out. `wpr()` and `mfi()` are NOT v3
// functions — both arrived in the March 2020 batch, which is v4 and later only.
// Spelled out here they still exercise highest/lowest and sum/change/hlc3, and
// they compile at v3.
wprHigh = highest(high, 14)
wprLow  = lowest(low, 14)
plot(100 * (close - wprHigh) / (wprHigh - wprLow), title="wpr_14_manual")

mfiTp   = hlc3
mfiFlow = mfiTp * volume
mfiPos  = sum(change(mfiTp) > 0 ? mfiFlow : 0, 14)
mfiNeg  = sum(change(mfiTp) < 0 ? mfiFlow : 0, 14)
plot(100 - 100 / (1 + mfiPos / mfiNeg), title="mfi_14_manual")
plot(alma(src, 20, 0.85, 6),        title="alma_20")
plot(percentrank(src, 20),          title="percentrank_20")
