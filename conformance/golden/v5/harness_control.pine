//@version=5
// ─────────────────────────────────────────────────────────────────────────────
// GENERATED — do not edit. Source: conformance/golden/v3/harness_control.pine
// Regenerate with: npx tsx scripts/make-log-harness.ts
//
// The Pine-Logs variant of that harness, for collecting golden data WITHOUT the
// PRO+/Premium "Export chart data…" feature.
//
//   1. Paste into the Pine editor and add to the chart.
//   2. Open  More (⋮) → Pine Logs.
//   3. Select all the log lines and copy them.
//   4. Save as conformance/golden/<version>/<harness>.<SYMBOL>.<TF>.log
//
// Pine Logs run on HISTORICAL bars — unlike alert(), which only ever fires on
// realtime bars — and keep the last 10,000 historical messages.
// ─────────────────────────────────────────────────────────────────────────────
// ─────────────────────────────────────────────────────────────────────────────
// OpenPineScript golden-data harness — CONDITIONAL FLOW.
//
// Control flow is not directly exportable: "Export chart data" gives plot
// values. So every branch here is WITNESSED by a number — the plotted value
// encodes which path the script took, so a disagreement in the CSV localises to
// a construct rather than to arithmetic.
//
// ⚠ NEEDS FULL HISTORY. The counters and the state machine carry state from bar
// 0 and never converge. Export this on a symbol whose whole history fits, as
// with harness_state.pine. Warm-up allowance is 0.
//
//
// NOTE: `else if` is deliberately absent — it is not Pine v3. Nested `if` is
// used instead.
// ─────────────────────────────────────────────────────────────────────────────
indicator(title="OPS golden control", shorttitle="OPS control", overlay=false)

src  = close
fast = ta.sma(src, 10)
slow = ta.sma(src, 30)

// 1. if/else as a STATEMENT, with ':=' in both branches.
trend = 0
if fast > slow
    trend := 1
else
    trend := -1
_v0 = trend

// 2. if with NO else. What the variable holds on the untaken bar is the whole
//    question — Pine leaves the previous assignment's value, it does not reset.
flag = 0
if close > open
    flag := 1
_v1 = flag

// 3. if as an EXPRESSION, which is a different grammar path from (1).
grade = if fast > slow
    2
else
    -2
_v2 = grade

// 4. Nested if/else, four reachable leaves.
zone = 0
if fast > slow
    if close > fast
        zone := 2
    else
        zone := 1
else
    if close < fast
        zone := -2
    else
        zone := -1
_v3 = zone

// 5. Ternary chain — same four leaves, expressed as expressions. Should agree
//    with (4) in shape; if it does not, one of the two paths is wrong.
band = close > fast ? (close > slow ? 3 : 2) : (close < slow ? -3 : -2)
_v4 = band

// 6. PROBE, not an assertion: does a ternary evaluate BOTH branches?
//    Pine's series functions need to be called on every bar to keep their
//    history continuous, so a stateful call inside one arm of a ternary is the
//    classic trap. Whether TradingView hoists these or lets the untaken arm go
//    stale is what the export answers.
_v5 = close > open ? ta.sma(close, 5) : ta.sma(close, 50)

// 7. PROBE: the same question for a call reached only inside an if-block.
condSma = 0.0
if close > open
    condSma := ta.sma(close, 5)
_v6 = condSma

// 8. Boolean operators, each isolated.
_v7 = (close > open and fast > slow) ? 1 : 0
_v8 = (close > open or  fast > slow) ? 1 : 0
_v9 = not (close > open)             ? 1 : 0

// 9. PROBE: does `and` short-circuit? If it does, the right-hand `sma` is not
//    called on bars where the left side is false, and its history diverges.
_v10 = (close > open and ta.sma(close, 7) > ta.sma(close, 21)) ? 1 : 0

// 10. A counter that only advances inside a branch — pure path dependence.
streak = 0
streak := close > close[1] ? nz(streak[1]) + 1 : 0
_v11 = streak

// 11. A two-state machine. Holds its state across bars and flips only on a
//     cross, so any single mis-taken branch changes every later bar.
state = 0
state := nz(state[1])
if fast > slow and nz(state[1]) <= 0
    state := 1
if fast < slow and nz(state[1]) >= 0
    state := -1
_v12 = state

// 12. Branch witnesses for the history-reading built-ins.
_v13 = ta.barssince(fast > slow)
_v14 = ta.valuewhen(fast > slow, close, 0)

// ── Pine Logs emission ──────────────────────────────────────────────────
// One row per bar. The OPS| marker lets the loader find the row inside
// whatever prefix the Pine Logs pane adds when you copy it out.
if barstate.isfirst
    log.info("OPSHEAD|time,open,high,low,close,volume,if_else_stmt,if_no_else,if_expr,nested_if,ternary_chain,probe_ternary_both_arms,probe_call_inside_if,and_gate,or_gate,not_gate,probe_and_shortcircuit,up_streak,state_machine,barssince_cross_up,valuewhen_cross_up")

_row = str.tostring(time, "#")
      + "," + str.tostring(open, "#.##########")
      + "," + str.tostring(high, "#.##########")
      + "," + str.tostring(low, "#.##########")
      + "," + str.tostring(close, "#.##########")
      + "," + str.tostring(volume, "#.##########")
      + "," + str.tostring(_v0, "#.##########")
      + "," + str.tostring(_v1, "#.##########")
      + "," + str.tostring(_v2, "#.##########")
      + "," + str.tostring(_v3, "#.##########")
      + "," + str.tostring(_v4, "#.##########")
      + "," + str.tostring(_v5, "#.##########")
      + "," + str.tostring(_v6, "#.##########")
      + "," + str.tostring(_v7, "#.##########")
      + "," + str.tostring(_v8, "#.##########")
      + "," + str.tostring(_v9, "#.##########")
      + "," + str.tostring(_v10, "#.##########")
      + "," + str.tostring(_v11, "#.##########")
      + "," + str.tostring(_v12, "#.##########")
      + "," + str.tostring(_v13, "#.##########")
      + "," + str.tostring(_v14, "#.##########")

log.info("OPS|" + _row)
