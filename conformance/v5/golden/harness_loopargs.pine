//@version=5
// ─────────────────────────────────────────────────────────────────────────────
// Hand-written, NOT generated. There is no v3 source for this one: it exists to
// answer a question the other harnesses raised, and the question is only about
// v5 spellings of the same rule.
//
//   1. Paste into the Pine editor and add to the chart.
//   2. Open  More (⋮) → Pine Logs.
//   3. Select all the log lines and copy them.
//   4. Save as conformance/v5/golden/harness_loopargs.BTCUSDT.1D.log
//
// Convergent — every column is a short average — so the standard warm-up
// allowance applies and this can be exported from anywhere in the chart.
// ─────────────────────────────────────────────────────────────────────────────
// OpenPineScript golden-data harness — ONE CALL SITE, DIFFERENT ARGUMENTS.
//
// The loops harness already settled what happens when a series function's call
// site is reached several times on one bar with the SAME arguments: the state
// advances once and every read returns the same value. `loopEma / 3` equals
// `ta.ema(close, 10)` there on every bar, to the last decimal.
//
// This asks the question that one could not: what happens when the arguments
// DIFFER between reaches. TradingView's own documentation publishes the
// pattern — "RMA in for loop", on the Expressions, declarations and statements
// page — so it is part of the language and an engine has to have an answer.
//
// `_v0` is that published example, unchanged. `_v1`, `_v2` and `_v3` are the
// three readings it could have, computed at call sites that are reached once
// each so they are not themselves in question. Whichever of them `_v0` matches
// is the rule:
//
//   _v1   the FIRST reach feeds the history, and later reaches re-read it
//   _v2   the LAST reach feeds it
//   _v3   each reach advances a history of its own
//
// `ta.rma(close, 1)` is `close`, which is what makes the three far apart
// enough to tell by eye as well as by diff.
//
// ⚠ Until this is collected, OpenPineScript REFUSES the pattern rather than
// pick one — see Context.requireSameArguments and the two pinned scripts in
// conformance/common/docs_corpus_execution.test.ts.
// ─────────────────────────────────────────────────────────────────────────────
indicator(title="OPS golden loop args", shorttitle="OPS loopargs", overlay=false)

// The published example, exactly as TradingView prints it.
sum = 0.0
for i = 1 to 2
    sum := sum + ta.rma(close, i)
_v0 = sum

// Reading 1: the first reach wins, both reads return it.
_v1 = ta.rma(close, 1) * 2

// Reading 2: the last reach wins, both reads return it.
_v2 = ta.rma(close, 2) * 2

// Reading 3: each reach keeps its own history.
_v3 = ta.rma(close, 1) + ta.rma(close, 2)

// The two averages on their own, so a disagreement can be attributed to one of
// them rather than left ambiguous between them.
_v4 = ta.rma(close, 1)
_v5 = ta.rma(close, 2)

// ── Pine Logs emission ──────────────────────────────────────────────────
// One row per bar. The OPS| marker lets the loader find the row inside
// whatever prefix the Pine Logs pane adds when you copy it out.
if barstate.isfirst
    log.info("OPSHEAD|time,open,high,low,close,volume,published_example,reading_first_wins,reading_last_wins,reading_each_advances,rma_1,rma_2")

_row = str.tostring(time, "#") + "," +
      str.tostring(open, "#.##########") + "," +
      str.tostring(high, "#.##########") + "," +
      str.tostring(low, "#.##########") + "," +
      str.tostring(close, "#.##########") + "," +
      str.tostring(volume, "#.##########") + "," +
      str.tostring(_v0, "#.##########") + "," +
      str.tostring(_v1, "#.##########") + "," +
      str.tostring(_v2, "#.##########") + "," +
      str.tostring(_v3, "#.##########") + "," +
      str.tostring(_v4, "#.##########") + "," +
      str.tostring(_v5, "#.##########")

log.info("OPS|" + _row)
