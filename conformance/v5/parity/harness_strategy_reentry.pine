//@version=5
// ─────────────────────────────────────────────────────────────────────────────
// OPS golden harness: re-entry, per-trade targets and a bar that hits two exits.
// Version 5, pyramiding = 2.
//
// RUN ON : BINANCE:BTCUSDT, 1D (daily), at least 181 bars loaded.
// SAVE AS: conformance/v5/parity/harness_strategy_reentry.BTCUSDT.1D.csv
//
// Collect it like this:
//   1. Pine Editor -> paste -> Add to chart. Don't scroll back, don't change the
//      timeframe afterwards.
//   2. Wait for the chart to finish loading (the script reads bars 0-180 only).
//   3. More (...) -> Pine Logs -> export (or select all and copy) and save as
//      the filename above.
//
// Phases (tag column). The bar indices are fixed for the first 181 daily bars of
// BTCUSDT; the wide bars were picked from that data so each outcome is clear.
//   a   (bars 0-19)   Question 4. B entry lc 1, A entry lc 2 (pyramiding 2, qty 1).
//       exit("xa", from_entry = "A", profit = 1) is placed on EVERY bar from lc 2.
//       It closes A on the first bar that trades a tick higher. A is entered
//       AGAIN on lc 7 while B keeps the position open. Does the new A trade get
//       its own xa (a second closed trade named xa, entry bar 8), or is xa spent?
//   b   (bars 20-39)  Question 5. L entered on lc 1 and again on lc 3 (qty 1; they
//       fill at 4691.66 and 4258.81, $433 apart). exit("X", "L", profit = 10000)
//       (a $100 target) is placed on every bar from lc 1. Is each trade's target
//       measured from its own price (the second trade: 4358.81, hit on bar 26) or
//       from the oldest (4791.66 for both, never reached in these bars)? Read
//       the closed trades and open_ids. close_all() on lc 17.
//   c1..c4            Question 6. Two entries, A on W-3 and B on W-2 (fill on W-2
//       and W-1), and on W-1 two exits at +2% and -2% of that bar's close. The
//       bar W trades through both. W is a bar where the open is closer to the HIGH
//       (c1: 145, c2: 153; the documented path is open -> high -> low -> close, so
//       the limit is reached first) or closer to the LOW (c3: 160, c4: 174; the
//       stop first).
//         c1  xl = limit from A, xs = stop from B     (W = 145, high first)
//         c2  xl = limit from B, xs = stop from A     (W = 153, high first)
//         c3  xl = limit from A, xs = stop from B     (W = 160, low first)
//         c4  xl = limit from B, xs = stop from A     (W = 174, low first)
//       Which trade does each exit close (the oldest, whatever its id?), at what
//       price, and in what order? close_all() on W+3.
//   Every bar logs position_size, avg_price, opentrades, closedtrades, netprofit
//   and open_ids (the open entries, id:size/...).
//
// Fixed quantities, commission 0, process_orders_on_close = false.
//
//   OPSMETA / OPSHEAD   script, symbol facts, then the column names, once
//   OPS|row|row|...     every bar 0-180, as many as fit in 3,900 characters:
//                       time,open,high,low,close,volume,bar_index,tag,
//                       position_size,avg_price,opentrades,closedtrades,netprofit,open_ids
//   OPSLAST             bar 180 again
//   OPSCOUNT            closed / open trade counts, net profit, position size
//   OPSCLOSED           every closed trade, entry_id:exit_id:entry_bar:exit_bar:
//                       entry_price:exit_price:size:profit
//   OPSOPEN             every open trade, entry_id:entry_bar:entry_price:size:profit
// ─────────────────────────────────────────────────────────────────────────────
strategy("OPS strategy reentry", overlay = true, default_qty_type = strategy.fixed, default_qty_value = 1,
     pyramiding = 2, commission_type = strategy.commission.percent, commission_value = 0, initial_capital = 1000000,
     process_orders_on_close = false)

OPS_SCRIPT = "strategy_reentry"
OPS_LAST = 180

lc = bar_index % 20
string ops_tag = bar_index < 20 ? "a" : bar_index < 40 ? "b" :
     bar_index >= 142 and bar_index <= 148 ? "c1" : bar_index >= 150 and bar_index <= 156 ? "c2" :
     bar_index >= 157 and bar_index <= 163 ? "c3" : bar_index >= 171 and bar_index <= 177 ? "c4" : "-"

// a) an exit placed every bar, and A entered again
if bar_index == 1
    strategy.entry("B", strategy.long, qty = 1)
if bar_index >= 2 and bar_index <= 14
    strategy.exit("xa", from_entry = "A", profit = 1)
if bar_index == 2 or bar_index == 7
    strategy.entry("A", strategy.long, qty = 1)
if bar_index == 14
    strategy.close_all()

// b) two fills of L at different prices, one exit order placed every bar
if bar_index == 21 or bar_index == 23
    strategy.entry("L", strategy.long, qty = 1)
if bar_index >= 21 and bar_index <= 36
    strategy.exit("X", "L", profit = 10000)
if bar_index == 37
    strategy.close_all()

// c) one wide bar W reaches a limit above and a stop below
f_pair(int w, bool limitFromA) =>
    if bar_index == w - 3
        strategy.entry("A", strategy.long, qty = 1)
    if bar_index == w - 2
        strategy.entry("B", strategy.long, qty = 1)
    if bar_index == w - 1
        strategy.exit("xl", from_entry = limitFromA ? "A" : "B", limit = close * 1.02)
        strategy.exit("xs", from_entry = limitFromA ? "B" : "A", stop = close * 0.98)
    if bar_index == w + 3
        strategy.close_all()
f_pair(145, true)
f_pair(153, false)
f_pair(160, true)
f_pair(174, false)

// ── OPS logging block ───────────────────────────────────────────────────────
ops_f(x) => str.tostring(x, "#.##########")

var ops_heads = array.new_string(0)
ops_vals = array.new_string(0)
ops_col(string name, string v) =>
    if barstate.isfirst
        ops_heads.push(name)
    ops_vals.push(v)

ops_col("time", str.tostring(time, "#"))
ops_col("open", ops_f(open))
ops_col("high", ops_f(high))
ops_col("low", ops_f(low))
ops_col("close", ops_f(close))
ops_col("volume", ops_f(volume))
ops_col("bar_index", str.tostring(bar_index))
ops_col("tag", ops_tag)
ops_col("position_size", ops_f(strategy.position_size))
ops_col("avg_price", ops_f(strategy.position_avg_price))
ops_col("opentrades", str.tostring(strategy.opentrades))
ops_col("closedtrades", str.tostring(strategy.closedtrades))
ops_col("netprofit", ops_f(strategy.netprofit))
string ops_ids = ""
if strategy.opentrades > 0
    for k = 0 to strategy.opentrades - 1
        ops_ids += (k > 0 ? "/" : "") + strategy.opentrades.entry_id(k) + ":" + ops_f(strategy.opentrades.size(k))
ops_col("open_ids", ops_ids == "" ? "-" : ops_ids)

if barstate.isfirst
    log.info("OPSMETA|script=" + OPS_SCRIPT + ",version=5,tickerid=" + syminfo.tickerid + ",mintick=" + ops_f(syminfo.mintick) +
         ",timezone=" + syminfo.timezone + ",timeframe=" + timeframe.period + ",type=" + syminfo.type)
    log.info("OPSHEAD|" + ops_heads.join(","))

// Pine v5 strings stop at 4,096 characters: a message goes out before the
// next row would take it past 3,900, so each stays under 4,000 with its prefix.
var string ops_buf = ""
ops_active = OPS_LAST < 0 or bar_index <= OPS_LAST
ops_final = OPS_LAST < 0 ? barstate.islast : bar_index == OPS_LAST
if barstate.isconfirmed and ops_active
    ops_next = "|" + ops_vals.join(",")
    if str.length(ops_buf) + str.length(ops_next) > 3900
        log.info("OPS" + ops_buf)
        ops_buf := ""
    ops_buf := ops_buf + ops_next
if str.length(ops_buf) > 0 and (barstate.islastconfirmedhistory or barstate.isrealtime or ops_final)
    log.info("OPS" + ops_buf)
    ops_buf := ""

// The trade dump, once, on the final bar. Entries are ;-separated, fields :-separated:
//   closed: entry_id : exit_id : entry_bar_index : exit_bar_index : entry_price : exit_price : size : profit
//   open:   entry_id : entry_bar_index : entry_price : size : profit
varip bool ops_dumped = false
if ops_final and not ops_dumped
    ops_dumped := true
    log.info("OPSLAST|" + ops_vals.join(","))
    ops_nc = strategy.closedtrades
    ops_no = strategy.opentrades
    log.info("OPSCOUNT|closed=" + str.tostring(ops_nc) + ",open=" + str.tostring(ops_no) +
         ",netprofit=" + ops_f(strategy.netprofit) + ",position_size=" + ops_f(strategy.position_size))
    ops_row = ""
    if ops_nc > 0
        for k = 0 to ops_nc - 1
            ops_row += ";" + strategy.closedtrades.entry_id(k) + ":" + strategy.closedtrades.exit_id(k) + ":" +
                 str.tostring(strategy.closedtrades.entry_bar_index(k)) + ":" + str.tostring(strategy.closedtrades.exit_bar_index(k)) + ":" +
                 ops_f(strategy.closedtrades.entry_price(k)) + ":" + ops_f(strategy.closedtrades.exit_price(k)) + ":" +
                 ops_f(strategy.closedtrades.size(k)) + ":" + ops_f(strategy.closedtrades.profit(k))
            if str.length(ops_row) > 3700 or k == ops_nc - 1
                log.info("OPSCLOSED|" + str.tostring(k) + ops_row)
                ops_row := ""
    if ops_no > 0
        for k = 0 to ops_no - 1
            ops_row += ";" + strategy.opentrades.entry_id(k) + ":" + str.tostring(strategy.opentrades.entry_bar_index(k)) + ":" +
                 ops_f(strategy.opentrades.entry_price(k)) + ":" + ops_f(strategy.opentrades.size(k)) + ":" +
                 ops_f(strategy.opentrades.profit(k))
            if str.length(ops_row) > 3700 or k == ops_no - 1
                log.info("OPSOPEN|" + str.tostring(k) + ops_row)
                ops_row := ""
